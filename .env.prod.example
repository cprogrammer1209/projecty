# Copy to .env next to compose.prod.yaml and fill in. Never commit the real .env.
DOCKERHUB_USER=your-dockerhub-username
IMAGE_TAG=production

POSTGRES_PASSWORD=change-me
# Shared by platform-service and work-service (cache, rate limits, token denylist).
REDIS_PASSWORD=change-me

# Public URL of platform-service as the browser reaches it (the Codespace forwarded URL for port 8081, or your domain).
PUBLIC_API_URL=https://example-8081.app.github.dev
# Where the customer app is hosted (Vercel) and every origin allowed to call the API.
FRONTEND_URL=https://projecty.vercel.app
CORS_ALLOWED_ORIGINS=https://projecty.vercel.app,https://projecty-admin.vercel.app

# First platform admin, created at startup when none exists.
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=change-me-to-a-long-password

# Leave SMTP_HOST and SMTP_PORT empty to use the bundled Mailpit (inbox on localhost:8025).
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
